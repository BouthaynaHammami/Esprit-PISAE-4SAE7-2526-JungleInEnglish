# Database
DB_URL=jdbc:mysql://localhost:3306/your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/devunity
KEYCLOAK_REALM=devunity
KEYCLOAK_CLIENT_ID=devunity-app
KEYCLOAK_ADMIN_USERNAME=your_keycloak_admin_username
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME_LANGUAGE=your_email@gmail.com
MAIL_PASSWORD_LANGUAGE=your_gmail_app_password
MAIL_USERNAME_COMMUNITY=your_email@gmail.com
MAIL_PASSWORD_COMMUNITY=your_gmail_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Eureka & Services
EUREKA_SERVER_URL=http://localhost:8761/eureka
FRONTEND_URL=http://localhost:4200
ML_SERVICE_URL=http://localhost:8090

# Elasticsearch
ELASTICSEARCH_HOST=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password
