pipeline {
    agent any

    tools {
        jdk 'jdk17'
        maven 'maven3'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        BACKEND_PATH = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        MAVEN_OPTS = '-Xmx1024m -XX:MaxMetaspaceSize=512m'
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Récupération du code source...'
                git branch: 'main',
                    credentialsId: 'devops',
                    url: 'https://github.com/saifelislem/Esprit-PIDEV-4SAE7-2026-DEVUNITY.git'
            }
        }

        stage('Build & Test') {
            steps {
                dir("${BACKEND_PATH}/Activity_Management_Service") {
                    sh 'mvn clean verify -e -X'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '🔍 Analyse SonarQube...'
                dir("${BACKEND_PATH}/Activity_Management_Service") {
                    sh '''
                        mvn sonar:sonar \
                        -Dsonar.host.url=http://sonarqube:9000 \
                        -Dsonar.login=$SONAR_TOKEN \
                        -Dsonar.projectKey=activity-management-service \
                        -Dsonar.projectName=ActivityManagementService
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {

        success {
            echo '✅ Pipeline terminé avec succès !'
        }

        failure {
            echo '❌ Pipeline échoué ! Vérifie les logs.'
        }

        always {
            echo '📊 Publication des résultats...'

            junit testResults: "${BACKEND_PATH}/Activity_Management_Service/target/surefire-reports/*.xml",
                  allowEmptyResults: true

            archiveArtifacts artifacts: '**/*.dump, **/*.dumpstream',
                              allowEmptyArchive: true

            cleanWs deleteDirs: true, patterns: [
                [pattern: '**/target/**', type: 'INCLUDE'],
                [pattern: '**/.m2/**', type: 'INCLUDE'],
                [pattern: '**/*.log', type: 'INCLUDE']
            ]
        }
    }
}