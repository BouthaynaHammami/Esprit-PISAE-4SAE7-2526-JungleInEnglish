pipeline {
    agent any

    tools {
        jdk 'jdk17'
        maven 'maven3'
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        BACKEND_PATH = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        SERVICE_DIR  = "${BACKEND_PATH}/Activity_Management_Service"

        IMAGE_NAME   = 'shayma2003/activity-management-service'
        IMAGE_TAG    = "${BUILD_NUMBER}"

        MAVEN_OPTS   = '-Xmx1024m -XX:MaxMetaspaceSize=512m'
    }

    stages {

        stage('Init') {
            steps {
                echo '🧹 Cleaning workspace'
                deleteDir() // Ensures fresh workspace, fixes "not in a git directory"
            }
        }

        stage('Checkout') {
            steps {
                echo '📥 Checking out source code'
                checkout scm // Make sure "Lightweight checkout" is **unchecked** in job config
            }
        }

        stage('Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    dir("${SERVICE_DIR}") {
                        junit allowEmptyResults: true,
                              testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    dir("${SERVICE_DIR}") {
                        sh '''
                        mvn sonar:sonar \
                        -Dsonar.projectKey=activity-management-service \
                        -Dsonar.projectName=ActivityManagementService \
                        -DskipTests
                        '''
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir("${SERVICE_DIR}") {
                    echo '📦 Deploying to Nexus'
                    sh '''
                    mvn deploy -DskipTests \
                    -s /var/jenkins_home/.m2/settings.xml
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    try {
                        dir("${SERVICE_DIR}") {
                            sh """
                            docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                            docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                            """
                        }
                    } catch (Exception e) {
                        echo "❌ Docker build failed: ${e.message}"
                        echo "💡 Possible solutions:"
                        echo "   1. Add Jenkins user to docker group: sudo usermod -aG docker jenkins"
                        echo "   2. Restart Jenkins: sudo systemctl restart jenkins"
                        echo "   3. Or set SKIP_DOCKER=true to skip Docker stages"
                        error("Docker build failed - check permissions")
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(
                            credentialsId: 'docker_token',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )]) {
                            dir("${SERVICE_DIR}") {
                                sh """
                                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                                docker push ${IMAGE_NAME}:${IMAGE_TAG}
                                docker push ${IMAGE_NAME}:latest
                                docker logout
                                """
                            }
                        }
                    } catch (Exception e) {
                        echo "❌ Docker push failed: ${e.message}"
                        error("Docker push failed")
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline SUCCESS'
        }
        failure {
            echo '❌ Pipeline FAILED'
        }
        always {
            cleanWs()
        }
    }
}
