pipeline {
    agent any

    tools {
        jdk 'jdk17'
        maven 'maven3'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        BACKEND_PATH = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        SERVICE_DIR  = "${BACKEND_PATH}/Activity_Management_Service"

        SONAR_HOST_URL = 'http://192.168.19.128:9000'
        NEXUS_URL      = 'http://192.168.19.128:8081'

        IMAGE_NAME = 'shayma2003/activity-management-service'
        MAVEN_OPTS = '-Xmx1024m -XX:MaxMetaspaceSize=512m'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Checkout source code'
                git branch: 'main',
                    credentialsId: 'git_token',
                    url: 'https://github.com/saifelislem/Esprit-PIDEV-4SAE7-2026-DEVUNITY.git'
            }
        }

        stage('Clean & Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn test || true'
                }
            }
            post {
                always {
                    dir("${SERVICE_DIR}") {
                        junit allowEmptyResults: true,
                              testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'sonar_token', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('sonarqube') {
                            dir("${SERVICE_DIR}") {
                                sh """
                                mvn sonar:sonar \
                                -Dsonar.projectKey=activity-management-service \
                                -Dsonar.projectName=ActivityManagementService \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.token=${SONAR_TOKEN}
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh """
                    mvn deploy -DskipTests \
                    -DaltDeploymentRepository=nexus::${NEXUS_URL}/repository/maven-snapshots/ \
                    -s /var/jenkins_home/.m2/settings.xml
                    """
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        dockerImage = docker.build("${IMAGE_NAME}:${BUILD_NUMBER}")
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'docker_token',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {

                        sh """
                        echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin

                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest

                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                        docker push ${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline SUCCESS'
        }
        failure {
            echo '❌ Pipeline FAILED'
        }
        always {
            cleanWs()
        }
    }
}