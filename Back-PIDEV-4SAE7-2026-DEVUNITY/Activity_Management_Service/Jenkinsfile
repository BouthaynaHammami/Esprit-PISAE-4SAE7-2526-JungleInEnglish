pipeline {
    agent any

    tools {
        jdk 'jdk17'
        maven 'maven3'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        BACKEND_PATH = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        SERVICE_DIR  = "${BACKEND_PATH}/Activity_Management_Service"

        IMAGE_NAME   = 'activity-management-service'
        IMAGE_TAG    = 'latest'

        MAVEN_OPTS   = '-Xmx1024m -XX:MaxMetaspaceSize=512m'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Checkout source code'
                git branch: 'main',
                    credentialsId: 'devops',
                    url: 'https://github.com/saifelislem/Esprit-PIDEV-4SAE7-2026-DEVUNITY.git'
            }
        }

        stage('Clean') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn clean'
                }
            }
        }

        stage('Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn test || true'
                }
            }
            post {
                always {
                    dir("${SERVICE_DIR}") {
                        junit allowEmptyResults: true,
                              testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    dir("${SERVICE_DIR}") {
                        sh '''
                        mvn sonar:sonar \
                        -Dsonar.projectKey=activity-management-service \
                        -Dsonar.projectName=ActivityManagementService \
                        -DskipTests
                        '''
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir("${SERVICE_DIR}") {
                    echo '📦 Deploying to Nexus'

                    sh '''
                    mvn deploy -DskipTests \
                        -s /var/jenkins_home/.m2/settings.xml
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    echo '🐳 Building Docker image'

                    sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Docker Run (Test)') {
            steps {
                sh """
                docker stop ${IMAGE_NAME} || true
                docker rm ${IMAGE_NAME} || true

                docker run -d -p 8084:8084 --name ${IMAGE_NAME} ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline SUCCESS'
        }
        failure {
            echo '❌ Pipeline FAILED'
        }
        always {
            cleanWs()
        }
    }
}