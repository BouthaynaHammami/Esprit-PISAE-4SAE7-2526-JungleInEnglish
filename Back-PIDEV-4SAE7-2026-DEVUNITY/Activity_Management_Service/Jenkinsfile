pipeline {
    agent any

    options {
        buildDiscarder(logRotator(
            numToKeepStr: '5',
            artifactNumToKeepStr: '5'
        ))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        BACKEND_PATH = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        SERVICE_DIR  = "${BACKEND_PATH}/Activity_Management_Service"

        IMAGE_NAME = 'shayma2003/activity-management-service'
        IMAGE_TAG  = "${BUILD_NUMBER}"

        MAVEN_OPTS = '-Xmx1024m -XX:MaxMetaspaceSize=512m'
    }

    stages {

        stage('Init') {
            steps {
                echo '🧹 Cleaning workspace'
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                echo '📥 Checking out source code'
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                java -version
                mvn -version
                docker version
                '''
            }
        }

        stage('Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn test'
                }
            }

            post {
                always {
                    dir("${SERVICE_DIR}") {
                        junit allowEmptyResults: true,
                               testResults: 'target/surefire-reports/*.xml'
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    try {

                        withSonarQubeEnv('sonarqube') {

                            dir("${SERVICE_DIR}") {

                                sh '''
                                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:4.0.0.4121:sonar \
                                -Dsonar.projectKey=activity-management-service \
                                -Dsonar.projectName=ActivityManagementService \
                                -DskipTests
                                '''
                            }
                        }

                    } catch (Exception e) {

                        echo "⚠️ SonarQube analysis failed"
                        echo e.toString()

                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {

                script {

                    try {

                        dir("${SERVICE_DIR}") {

                            echo '📦 Deploying artifact to Nexus'

                            sh '''
                            mvn deploy -DskipTests \
                            -s /var/jenkins_home/.m2/settings.xml
                            '''
                        }

                    } catch (Exception e) {

                        echo "⚠️ Nexus deployment failed"
                        echo e.toString()

                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {

                dir("${SERVICE_DIR}") {

                    sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Docker Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker_token',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    dir("${SERVICE_DIR}") {

                        sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest

                        docker logout
                        """
                    }
                }
            }
        }
    }

    post {

        success {
            echo '✅ PIPELINE SUCCESS'
        }

        unstable {
            echo '⚠️ PIPELINE UNSTABLE'
        }

        failure {
            echo '❌ PIPELINE FAILED'
        }

        always {
            cleanWs()
        }
    }
}