pipeline {
    agent any

    tools {
        jdk 'JAVA_HOME'
        maven 'MAVEN_HOME'
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Tag de l\'image Docker à déployer (passé par le CI)')
    }

    environment {
        BACKEND_PATH            = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        SOCIAL_SERVICE_PATH     = "${BACKEND_PATH}/Social_Interaction_Service"

        DOCKER_IMAGE            = 'hbouthayna/social-interaction-service'

        HELM_CHART_PATH         = "${SOCIAL_SERVICE_PATH}/charts/social-interaction"
        KUBE_CREDENTIALS_ID     = 'kubeconfig'
        NAMESPACE               = 'dev-unity'

        SLACK_CHANNEL           = '#dev-unity-cd'
        JMETER_PATH             = '/opt/apache-jmeter/bin/jmeter'
    }


    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'git_token',
                    url: 'https://github.com/saifelislem/Esprit-PIDEV-4SAE7-2026-DEVUNITY.git'
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'docker_token',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                            docker push ${DOCKER_IMAGE}:${params.IMAGE_TAG}
                            docker tag ${DOCKER_IMAGE}:${params.IMAGE_TAG} ${DOCKER_IMAGE}:latest
                            docker push ${DOCKER_IMAGE}:latest
                            docker logout
                        """
                    }
                }
            }
        }


        stage('Helm Deploy') {
            steps {
                script {
                    echo "Déploiement du tag image: ${params.IMAGE_TAG}"
                    withKubeConfig([credentialsId: "${KUBE_CREDENTIALS_ID}"]) {
                        withCredentials([
                            usernamePassword(credentialsId: 'db-credentials',
                                            usernameVariable: 'DB_USER',
                                            passwordVariable: 'DB_PASS'),
                            string(credentialsId: 'elasticsearch-password',
                                   variable: 'ES_PASS')
                        ]) {
                            sh """
                                helm upgrade --install social-interaction ${HELM_CHART_PATH} \\
                                --set image.repository=${DOCKER_IMAGE} \\
                                --set image.tag=${params.IMAGE_TAG} \\
                                --set image.pullPolicy=Always \\
                                --set config.dbUsername="\${DB_USER}" \\
                                --set config.dbPassword="\${DB_PASS}" \\
                                --set config.elasticsearchPassword="\${ES_PASS}" \\
                                --namespace ${NAMESPACE} --create-namespace \\
                                --atomic --timeout 10m
                            """
                        }
                    }
                }
            }
        }


        stage('kubectl apply') {
            steps {
                script {
                    withKubeConfig([credentialsId: "${KUBE_CREDENTIALS_ID}"]) {
                        withCredentials([
                            usernamePassword(credentialsId: 'db-credentials',
                                            usernameVariable: 'DB_USER',
                                            passwordVariable: 'DB_PASS'),
                            string(credentialsId: 'elasticsearch-password',
                                   variable: 'ES_PASS')
                        ]) {
                            sh """
                                helm template social-interaction ${HELM_CHART_PATH} \\
                                --set image.repository=${DOCKER_IMAGE} \\
                                --set image.tag=${params.IMAGE_TAG} \\
                                --set image.pullPolicy=Always \\
                                --set config.dbUsername="\${DB_USER}" \\
                                --set config.dbPassword="\${DB_PASS}" \\
                                --set config.elasticsearchPassword="\${ES_PASS}" \\
                                --namespace ${NAMESPACE} \\
                                > /tmp/social-interaction-manifests.yaml
                            """

                            sh """
                                kubectl apply -f /tmp/social-interaction-manifests.yaml \\
                                --namespace ${NAMESPACE}
                            """

                            sh "rm -f /tmp/social-interaction-manifests.yaml"
                        }
                    }
                }
            }
        }


        stage('Wait & Verify') {
            steps {
                script {
                    withKubeConfig([credentialsId: "${KUBE_CREDENTIALS_ID}"]) {
                        def deployName = sh(
                            script: "kubectl get deployment -n ${NAMESPACE} -l 'app.kubernetes.io/instance=social-interaction' -o jsonpath='{.items[0].metadata.name}'",
                            returnStdout: true
                        ).trim()

                        echo "Deployment détecté : ${deployName}"

                        def status = sh(
                            script: "kubectl rollout status deployment/${deployName} -n ${NAMESPACE} --timeout=600s",
                            returnStatus: true
                        )

                        if (status != 0) {
                            echo "❌ Rollout échoué – collecte des logs de diagnostic"
                            sh """
                                echo "=== DESCRIBE PODS ==="
                                kubectl describe pod -n ${NAMESPACE} -l 'app.kubernetes.io/instance=social-interaction' || true
                                echo "=== LOGS POD (dernières 100 lignes) ==="
                                kubectl logs -n ${NAMESPACE} -l 'app.kubernetes.io/instance=social-interaction' --tail=100 --previous || \\
                                kubectl logs -n ${NAMESPACE} -l 'app.kubernetes.io/instance=social-interaction' --tail=100 || true
                                echo "=== EVENTS NAMESPACE ==="
                                kubectl get events -n ${NAMESPACE} --sort-by='.lastTimestamp' | tail -20 || true
                            """
                            echo "❌ Déclenchement du rollback Helm"
                            sh "helm rollback social-interaction 0 --namespace ${NAMESPACE}"
                            error("Déploiement échoué – rollback Helm effectué automatiquement")
                        }
                    }
                }
            }
        }


        stage('JMeter Performance Tests') {
            steps {
                script {
                    withKubeConfig([credentialsId: "${KUBE_CREDENTIALS_ID}"]) {
                        sh "kubectl port-forward svc/social-interaction -n ${NAMESPACE} 8085:8085 &"
                        sh "sleep 5"

                        dir("${SOCIAL_SERVICE_PATH}") {
                            sh """
                                ${JMETER_PATH} -n -t performance-test.jmx -l results.jtl \\
                                -Jtarget_host=localhost \\
                                -Jtarget_port=8085
                            """
                        }

                        sh "pkill -f 'kubectl port-forward' || true"
                    }
                }
            }
            post {
                always {
                    perfReport sourceDataFiles: "${SOCIAL_SERVICE_PATH}/results.jtl"
                    archiveArtifacts artifacts: "${SOCIAL_SERVICE_PATH}/results.jtl"
                }
            }
        }


        stage('Prometheus/Grafana') {
            steps {
                script {
                    withKubeConfig([credentialsId: "${KUBE_CREDENTIALS_ID}"]) {
                        def podName = sh(
                            script: "kubectl get pod -n ${NAMESPACE} -l 'app.kubernetes.io/instance=social-interaction' -o jsonpath='{.items[0].metadata.name}'",
                            returnStdout: true
                        ).trim()

                        def metricsStatus = sh(
                            script: "kubectl exec ${podName} -n ${NAMESPACE} -- wget -qO- http://localhost:8085/socials/api/actuator/health 2>/dev/null || echo 'UNREACHABLE'",
                            returnStdout: true
                        ).trim()

                        echo "Actuator health: ${metricsStatus}"
                        if (!metricsStatus.contains('UP')) {
                            unstable("⚠️ Actuator health non OK – vérifier Prometheus scraping")
                        }

                        echo "Dashboard Grafana: http://grafana.dev-unity.local"
                    }
                }
            }
        }


        stage('Slack Notify') {
            steps {
                script {
                    def color   = currentBuild.currentResult == 'SUCCESS' ? 'good' : 'danger'
                    def message = """
                        *CD Pipeline – Social Interaction Service*
                        *Résultat :* ${currentBuild.currentResult}
                        *Build :* <${env.BUILD_URL}|#${env.BUILD_NUMBER}>
                        *Image :* ${DOCKER_IMAGE}:${params.IMAGE_TAG}
                        *Namespace :* ${NAMESPACE}
                    """.stripIndent()
                    slackSend(channel: "${SLACK_CHANNEL}", color: color, message: message)
                }
            }
        }
    }

    post {
        failure { echo '❌ Pipeline CD ÉCHOUÉ' }
        success { echo '✅ Pipeline CD RÉUSSI' }
    }
}
