pipeline {
    agent any
    tools {
        jdk 'JAVA_HOME'
        maven 'MAVEN_HOME'
    }
    environment {
        BACKEND_PATH = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        SOCIAL_SERVICE_PATH = "${BACKEND_PATH}/Social_Interaction_Service"
        SONAR_HOST_URL = 'http://192.168.184.128:9000'
        NEXUS_URL = 'http://192.168.184.128:8081'
        MAVEN_OPTS = '-Xmx512m -XX:MaxMetaspaceSize=256m'
        DOCKER_IMAGE = 'hbouthayna/social-interaction-service'
    }
    stages {
        stage('Checkout') {
            steps {
                echo 'Récupération du code source...'
                git branch: 'main',
                    credentialsId: 'git_token',
                    url: 'https://github.com/saifelislem/Esprit-PIDEV-4SAE7-2026-DEVUNITY.git'
            }
        }
        stage('Clean & Build') {
            steps {
                echo 'Nettoyage et Compilation...'
                dir("${SOCIAL_SERVICE_PATH}") {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }
        stage('Test') {
            steps {
                echo 'Exécution des tests unitaires...'
                dir("${SOCIAL_SERVICE_PATH}") {
                    sh 'mvn test || true'
                }
            }
        }
        stage('Semgrep Security Scan') {
            steps {
                script {
                    echo 'Analyse de sécurité avec Semgrep via Docker...'
                    withCredentials([string(credentialsId: 'semgrep_token', variable: 'SEMGREP_APP_TOKEN')]) {
                        docker.image('semgrep/semgrep').inside("""
                            -e SEMGREP_APP_TOKEN=${SEMGREP_APP_TOKEN} \
                            -e HOME=/tmp \
                            -e SEMGREP_USER_DATA_DIR=/tmp/semgrep \
                        """) {
                            dir("${SOCIAL_SERVICE_PATH}") {
                                sh 'semgrep scan --config auto || true'
                            }
                        }
                    }
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                script {
                    echo 'Analyse SonarQube...'
                    withCredentials([string(credentialsId: 'sonar_token', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('sonarqube') {
                            dir("${SOCIAL_SERVICE_PATH}") {
                                sh """
                                    mvn sonar:sonar \
                                    -Dsonar.projectKey=Social-Interaction-Service \
                                    -Dsonar.projectName='Social Interaction Service' \
                                    -Dsonar.host.url=${SONAR_HOST_URL} \
                                    -Dsonar.token=${SONAR_TOKEN}
                                """
                            }
                        }
                    }
                }
            }
        }
        stage('Deploy to Nexus') {
            steps {
                echo 'Déploiement sur Nexus...'
                dir("${SOCIAL_SERVICE_PATH}") {
                    sh """
                        mvn deploy -DskipTests \
                        -DaltDeploymentRepository=nexus::${NEXUS_URL}/repository/maven-snapshots/
                    """
                }
            }
        }
        stage('Docker Build') {
            steps {
                echo 'Construction de l image Docker...'
                dir("${SOCIAL_SERVICE_PATH}") {
                    script {
                        dockerImage = docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}")
                    }
                }
            }
        }
        stage('Docker Push') {
            steps {
                echo 'Push de l image sur Docker Hub...'
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'docker_token',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin
                            docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                            docker tag ${DOCKER_IMAGE}:${BUILD_NUMBER} ${DOCKER_IMAGE}:latest
                            docker push ${DOCKER_IMAGE}:latest
                        """
                    }
                }
            }
        }
    }
    post {
        always {
            junit testResults: "${SOCIAL_SERVICE_PATH}/target/surefire-reports/*.xml", allowEmptyResults: true
            cleanWs()
        }
        success {
            echo '✅ Pipeline terminé avec succès !'
        }
        failure {
            echo '❌ Le pipeline a échoué.'
        }
    }
}