pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven'
    }

    environment {
        JAVA_HOME = "${tool 'JDK17'}"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Récupération du code...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Compilation Maven...'
                dir('Back-PIDEV-4SAE7-2026-DEVUNITY/Community_Engagement_Service') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo 'Analyse SonarQube...'
                dir('Back-PIDEV-4SAE7-2026-DEVUNITY/Community_Engagement_Service') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=community-engagement-service'
                    }
                }
            }
        }


        stage('Deploy to Nexus') {
            parallel {
                stage('Deploy Community') {
                    steps {
                        dir("Back-PIDEV-4SAE7-2026-DEVUNITY/Community_Engagement_Service") {
                            sh """
                                mvn deploy -DskipTests \
                                -DaltDeploymentRepository=nexus::default::http://192.168.232.133:8081/repository/Devunity-snapshots/
                            """
                        }
                    }
                }
    }

    post {
        success {
            echo 'Build réussi !'
        }
        failure {
            echo 'Build échoué !'
        }
        always {
            cleanWs()
        }
    }
}