pipeline {
    agent any

    environment {
        DOCKERHUB_REPO = "chelba/learner-management-service"
        NEXUS_REPO     = "192.168.32.133:8082/Learner_Management_Service"
        IMAGE_TAG      = "v${BUILD_NUMBER}"
        SONAR_PROJECT  = "Learner_Management_Service"
    }

    tools {
        maven 'Maven3'
        jdk   'JDK17'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Unit Tests') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        mvn sonar:sonar \
                          -Dsonar.projectKey=${SONAR_PROJECT} \
                          -Dsonar.projectName=${SONAR_PROJECT}
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${DOCKERHUB_REPO}:${IMAGE_TAG} .'
                sh 'docker tag ${DOCKERHUB_REPO}:${IMAGE_TAG} ${DOCKERHUB_REPO}:latest'
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                    sh 'docker push ${DOCKERHUB_REPO}:${IMAGE_TAG}'
                    sh 'docker push ${DOCKERHUB_REPO}:latest'
                }
            }
        }

    }

    post {
        success {
            mail to: 'islemraissi789@gmail.com',
                 subject: "✅ CI PASSED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Build passed.\nSonarQube scan passed.\nDocker image pushed.\n\nCheck: ${env.BUILD_URL}"
        }
        failure {
            mail to: 'islemraissi789@gmail.com',
                 subject: "❌ CI FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Build failed at stage. Check logs:\n${env.BUILD_URL}"
        }
    }
}