pipeline {
    agent any

    environment {
        DOCKERHUB_REPO = "saifby/language-courses-service"
        IMAGE_TAG      = "latest"
        K8S_DIR        = "Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/k8s"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                    sh 'docker pull ${DOCKERHUB_REPO}:${IMAGE_TAG}'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl apply -f ${K8S_DIR}/mysql-secret.yaml
                    kubectl apply -f ${K8S_DIR}/mysql-deployment.yaml
                    kubectl apply -f ${K8S_DIR}/deployment.yaml
                    kubectl apply -f ${K8S_DIR}/service.yaml
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "Waiting for pods to start..."
                    sleep 30
                    kubectl get pods
                    kubectl get services
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "Waiting for app to be ready..."
                    sleep 60
                    kubectl rollout status deployment/language-courses-service --timeout=120s
                '''
            }
        }

        stage('Deploy Local Docker Backup') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'mysql-credentials',
                    usernameVariable: 'MYSQL_USER',
                    passwordVariable: 'MYSQL_PASS'
                )]) {
                    sh '''
                        docker network create app-network || true

                        docker stop language-courses-service || true
                        docker rm language-courses-service || true

                        docker stop mysql-local || true
                        docker rm mysql-local || true

                        docker run -d \
                          --name mysql-local \
                          --network app-network \
                          -e MYSQL_ROOT_PASSWORD=${MYSQL_PASS} \
                          -e MYSQL_DATABASE=Language_Courses \
                          -v mysql_data:/var/lib/mysql \
                          --restart unless-stopped \
                          mysql:8

                        sleep 20

                        docker run -d \
                          --name language-courses-service \
                          --network app-network \
                          -p 8086:8086 \
                          -e SPRING_DATASOURCE_URL=jdbc:mysql://mysql-local:3306/Language_Courses?createDatabaseIfNotExist=true \
                          -e SPRING_DATASOURCE_USERNAME=${MYSQL_USER} \
                          -e SPRING_DATASOURCE_PASSWORD=${MYSQL_PASS} \
                          -e SPRING_JPA_HIBERNATE_DDL_AUTO=update \
                          -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://192.168.32.1:8761/eureka \
                          -e SERVER_PORT=8086 \
                          -e SERVER_SERVLET_CONTEXT_PATH=/language-courses/api \
                          --restart unless-stopped \
                          ${DOCKERHUB_REPO}:${IMAGE_TAG}
                    '''
                }
            }
        }

    }

    post {
        success {
            mail to: 'islemraissi789@gmail.com',
                 subject: "✅ CD PASSED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Deployment successful!\nApp running on port 8086\n\n${env.BUILD_URL}"
        }
        failure {
            mail to: 'islemraissi789@gmail.com',
                 subject: "❌ CD FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Deployment failed. Check logs:\n${env.BUILD_URL}"
        }
    }
}
