pipeline {
    agent any

    environment {
        DOCKERHUB_REPO = "saifby/language-courses-service"
        IMAGE_TAG      = "v${BUILD_NUMBER}"
        BUILD_DIR      = "${WORKSPACE}/build-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Build') {
            steps {
                sh '''
                    rm -rf ${BUILD_DIR}
                    mkdir -p ${BUILD_DIR}
                    cp -r Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/Dockerfile \
                         Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/pom.xml \
                         Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/src \
                         Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/k8s \
                         ${BUILD_DIR}/
                '''
            }
        }

        stage('Build with Maven Container') {
            steps {
                sh '''
                    docker run --rm \
                        -v ${WORKSPACE}:/jenkins-workspace \
                        -w /jenkins-workspace/build-${BUILD_NUMBER} \
                        maven:3.9.15-eclipse-temurin-17 \
                        mvn clean package -DskipTests
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    docker run --rm \
                        -v ${WORKSPACE}:/jenkins-workspace \
                        -w /jenkins-workspace/build-${BUILD_NUMBER} \
                        maven:3.9.15-eclipse-temurin-17 \
                        mvn test
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'build-${BUILD_NUMBER}/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    cd ${BUILD_DIR}
                    docker build -t ${DOCKERHUB_REPO}:${IMAGE_TAG} .
                    docker tag ${DOCKERHUB_REPO}:${IMAGE_TAG} ${DOCKERHUB_REPO}:latest
                '''
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo $PASS | docker login -u $USER --password-stdin
                        docker push ${DOCKERHUB_REPO}:${IMAGE_TAG}
                        docker push ${DOCKERHUB_REPO}:latest
                        docker logout
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ Build réussi ! Image Docker: ${DOCKERHUB_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Build échoué. Vérifiez les logs."
        }
        always {
            sh 'rm -rf ${BUILD_DIR}'
        }
    }
}
