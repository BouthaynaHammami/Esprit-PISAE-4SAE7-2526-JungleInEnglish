pipeline {
    agent any

    environment {
        DOCKERHUB_REPO = "saifby/language-courses-service"
        IMAGE_TAG      = "v${BUILD_NUMBER}"
        BUILD_DIR      = "/tmp/lcs-build-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Build') {
            steps {
                sh '''
                    rm -rf ${BUILD_DIR}
                    mkdir -p ${BUILD_DIR}
                    # Copy the entire Back directory to preserve the structure
                    cp -r Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service ${BUILD_DIR}/
                '''
            }
        }

        stage('Build with Maven Container') {
            steps {
                sh '''
                    docker run --rm \
                        -v ${BUILD_DIR}/Language_Courses_Service:/workspace \
                        -w /workspace \
                        maven:3.9.15-eclipse-temurin-17 \
                        mvn clean package -DskipTests
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    docker run --rm \
                        -v ${BUILD_DIR}/Language_Courses_Service:/workspace \
                        -w /workspace \
                        maven:3.9.15-eclipse-temurin-17 \
                        mvn test
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '${BUILD_DIR}/Language_Courses_Service/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('${BUILD_DIR}/Language_Courses_Service') {
                    sh '''
                        docker build -t ${DOCKERHUB_REPO}:${IMAGE_TAG} .
                        docker tag ${DOCKERHUB_REPO}:${IMAGE_TAG} ${DOCKERHUB_REPO}:latest
                    '''
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo $PASS | docker login -u $USER --password-stdin
                        docker push ${DOCKERHUB_REPO}:${IMAGE_TAG}
                        docker push ${DOCKERHUB_REPO}:latest
                        docker logout
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ Build réussi ! Image Docker: ${DOCKERHUB_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Build échoué. Vérifiez les logs."
        }
        always {
            sh 'rm -rf ${BUILD_DIR}'
        }
    }
}
