pipeline {
    agent any

    environment {
        DOCKERHUB_REPO = "saifby/language-courses-service"
        IMAGE_TAG      = "v${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug - Show Structure') {
            steps {
                sh '''
                    echo "========== Root Directory =========="
                    ls -la
                    
                    echo "========== Back Directory =========="
                    ls -la Back-PIDEV-4SAE7-2026-DEVUNITY/
                    
                    echo "========== Language_Courses_Service =========="
                    ls -la Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/
                    
                    echo "========== Find pom.xml =========="
                    find Back-PIDEV-4SAE7-2026-DEVUNITY -name "pom.xml" -type f
                    
                    echo "========== Prepare Build =========="
                    rm -rf /tmp/lcs-build-${BUILD_NUMBER}
                    mkdir -p /tmp/lcs-build-${BUILD_NUMBER}
                    cp -r Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/* /tmp/lcs-build-${BUILD_NUMBER}/
                    
                    echo "========== /tmp/lcs-build Contents =========="
                    ls -la /tmp/lcs-build-${BUILD_NUMBER}/
                    
                    echo "========== Check pom.xml in /tmp =========="
                    ls -la /tmp/lcs-build-${BUILD_NUMBER}/pom.xml 2>/dev/null || echo "pom.xml NOT FOUND"
                '''
            }
        }

        stage('Build with Maven Container') {
            steps {
                sh '''
                    docker run --rm \
                        -v /tmp/lcs-build-${BUILD_NUMBER}:/workspace \
                        -w /workspace \
                        maven:3.9.15-eclipse-temurin-17 \
                        mvn clean package -DskipTests
                    
                    # Copier les artifacts back
                    cp -r /tmp/lcs-build-${BUILD_NUMBER}/target Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/ 2>/dev/null || true
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    docker run --rm \
                        -v /tmp/lcs-build-${BUILD_NUMBER}:/workspace \
                        -w /workspace \
                        maven:3.9.15-eclipse-temurin-17 \
                        mvn test
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Back-PIDEV-4SAE7-2026-DEVUNITY/Language_Courses_Service') {
                    sh '''
                        docker build -t ${DOCKERHUB_REPO}:${IMAGE_TAG} .
                        docker tag ${DOCKERHUB_REPO}:${IMAGE_TAG} ${DOCKERHUB_REPO}:latest
                    '''
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo $PASS | docker login -u $USER --password-stdin
                        docker push ${DOCKERHUB_REPO}:${IMAGE_TAG}
                        docker push ${DOCKERHUB_REPO}:latest
                        docker logout
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ Build réussi ! Image Docker: ${DOCKERHUB_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Build échoué. Vérifiez les logs."
        }
        always {
            sh 'rm -rf /tmp/lcs-build-${BUILD_NUMBER}'
        }
    }
}
