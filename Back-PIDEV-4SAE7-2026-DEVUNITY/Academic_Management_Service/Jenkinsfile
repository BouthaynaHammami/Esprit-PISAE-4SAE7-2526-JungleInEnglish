pipeline {
    agent any
    tools {
        jdk 'jdk17'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    environment {
        BACKEND_PATH = 'Back-PIDEV-4SAE7-2026-DEVUNITY'
        FRONTEND_PATH = 'Front-PIDEV-4SAE7-2026-DEVUNITY'
        SONAR_HOST_URL = 'http://192.168.22.130:9000'
        NEXUS_URL = 'http://192.168.22.130:8081'
        MAVEN_OPTS = '-Xmx512m -XX:MaxMetaspaceSize=256m'
        DOCKER_REGISTRY = 'chaibimarwa'
        REGISTRY_CREDENTIAL = 'REGISTRY_CREDENTIAL'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Récupération du code source...'
                git branch: 'main',
                    credentialsId: 'gittokens',
                    url: 'https://github.com/saifelislem/Esprit-PIDEV-4SAE7-2026-DEVUNITY.git'
            }
        }

        stage('Clean') {
            parallel {
                stage('Clean Academic') {
                    steps {
                        dir("${BACKEND_PATH}/Academic_Management_Service") {
                            sh 'mvn clean'
                        }
                    }
                }
                stage('Clean Discovery') {
                    steps {
                        dir("${BACKEND_PATH}/Discovery_Service") {
                            sh 'mvn clean'
                        }
                    }
                }
                stage('Clean API Gateway') {
                    steps {
                        dir("${BACKEND_PATH}/API_Gateway") {
                            sh 'mvn clean'
                        }
                    }
                }
            }
        }

        stage('Build') {
            parallel {
                stage('Build Academic') {
                    steps {
                        dir("${BACKEND_PATH}/Academic_Management_Service") {
                            sh 'mvn install -DskipTests'
                        }
                    }
                }
                stage('Build Discovery') {
                    steps {
                        dir("${BACKEND_PATH}/Discovery_Service") {
                            sh 'mvn install -DskipTests'
                        }
                    }
                }
                stage('Build API Gateway') {
                    steps {
                        dir("${BACKEND_PATH}/API_Gateway") {
                            sh 'mvn install -DskipTests'
                        }
                    }
                }
            }
        }

        stage('Test') {
            parallel {
                stage('Test Academic') {
                    steps {
                        dir("${BACKEND_PATH}/Academic_Management_Service") {
                            sh 'mvn test'
                        }
                    }
                }
                stage('Test Discovery') {
                    steps {
                        dir("${BACKEND_PATH}/Discovery_Service") {
                            sh 'mvn test || true'
                        }
                    }
                }
                stage('Test API Gateway') {
                    steps {
                        dir("${BACKEND_PATH}/API_Gateway") {
                            sh 'mvn test || true'
                        }
                    }
                }
            }
        }

        stage('Snyk Security Scan') {
            parallel {
                stage('Snyk Academic') {
                    steps {
                        dir("${BACKEND_PATH}/Academic_Management_Service") {
                            snykSecurity(
                                snykInstallation: 'snyk',
                                snykTokenId: 'snyk-api-token',
                                failOnIssues: false,
                                monitorProjectOnBuild: true,
                                additionalArguments: '--file=pom.xml --severity-threshold=high'
                            )
                        }
                    }
                }
                stage('Snyk Discovery') {
                    steps {
                        dir("${BACKEND_PATH}/Discovery_Service") {
                            snykSecurity(
                                snykInstallation: 'snyk',
                                snykTokenId: 'snyk-api-token',
                                failOnIssues: false,
                                monitorProjectOnBuild: true,
                                additionalArguments: '--file=pom.xml --severity-threshold=high'
                            )
                        }
                    }
                }
                stage('Snyk API Gateway') {
                    steps {
                        dir("${BACKEND_PATH}/API_Gateway") {
                            snykSecurity(
                                snykInstallation: 'snyk',
                                snykTokenId: 'snyk-api-token',
                                failOnIssues: false,
                                monitorProjectOnBuild: true,
                                additionalArguments: '--file=pom.xml --severity-threshold=high'
                            )
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            parallel {
                stage('Sonar Academic') {
                    steps {
                        script {
                            withSonarQubeEnv('sonarqube') {
                                dir("${BACKEND_PATH}/Academic_Management_Service") {
                                    sh """
                                        mvn sonar:sonar \
                                        -Dsonar.projectKey=Academic-Management-Service \
                                        -Dsonar.projectName='Academic Management Service' \
                                        -Dsonar.host.url=${SONAR_HOST_URL} \
                                        -Dsonar.java.binaries=target/classes \
                                        -Dsonar.java.test.binaries=target/test-classes \
                                        -Dsonar.sources=src/main/java \
                                        -Dsonar.tests=src/test/java
                                    """
                                }
                            }
                        }
                    }
                }
                stage('Sonar Discovery') {
                    steps {
                        script {
                            withSonarQubeEnv('sonarqube') {
                                dir("${BACKEND_PATH}/Discovery_Service") {
                                    sh """
                                        mvn sonar:sonar \
                                        -Dsonar.projectKey=Discovery-Service \
                                        -Dsonar.projectName='Discovery Service' \
                                        -Dsonar.host.url=${SONAR_HOST_URL} \
                                        -Dsonar.java.binaries=target/classes \
                                        -Dsonar.sources=src/main/java
                                    """
                                }
                            }
                        }
                    }
                }
                stage('Sonar API Gateway') {
                    steps {
                        script {
                            withSonarQubeEnv('sonarqube') {
                                dir("${BACKEND_PATH}/API_Gateway") {
                                    sh """
                                        mvn sonar:sonar \
                                        -Dsonar.projectKey=API-Gateway \
                                        -Dsonar.projectName='API Gateway' \
                                        -Dsonar.host.url=${SONAR_HOST_URL} \
                                        -Dsonar.java.binaries=target/classes \
                                        -Dsonar.sources=src/main/java
                                    """
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            parallel {
                stage('Deploy Academic') {
                    steps {
                        dir("${BACKEND_PATH}/Academic_Management_Service") {
                            sh """
                                mvn deploy -DskipTests \
                                -DaltDeploymentRepository=nexus::default::${NEXUS_URL}/repository/maven-snapshots/
                            """
                        }
                    }
                }
                stage('Deploy Discovery') {
                    steps {
                        dir("${BACKEND_PATH}/Discovery_Service") {
                            sh """
                                mvn deploy -DskipTests \
                                -DaltDeploymentRepository=nexus::default::${NEXUS_URL}/repository/maven-snapshots/
                            """
                        }
                    }
                }
                stage('Deploy API Gateway') {
                    steps {
                        dir("${BACKEND_PATH}/API_Gateway") {
                            sh """
                                mvn deploy -DskipTests \
                                -DaltDeploymentRepository=nexus::default::${NEXUS_URL}/repository/maven-snapshots/
                            """
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Build Image Academic') {
                    steps {
                        script {
                            dockerImageAcademic = docker.build(
                                "${DOCKER_REGISTRY}/academic-management-service:${BUILD_NUMBER}",
                                "-f ${BACKEND_PATH}/Academic_Management_Service/Dockerfile ."
                            )
                        }
                    }
                }
                stage('Build Image Discovery') {
                    steps {
                        script {
                            dockerImageDiscovery = docker.build(
                                "${DOCKER_REGISTRY}/discovery-service:${BUILD_NUMBER}",
                                "-f ${BACKEND_PATH}/Discovery_Service/Dockerfile ."
                            )
                        }
                    }
                }
                stage('Build Image API Gateway') {
                    steps {
                        script {
                            dockerImageGateway = docker.build(
                                "${DOCKER_REGISTRY}/api-gateway:${BUILD_NUMBER}",
                                "-f ${BACKEND_PATH}/API_Gateway/Dockerfile ."
                            )
                        }
                    }
                }
            }
        }

        stage('Push Docker Images') {
            parallel {
                stage('Push Image Academic') {
                    steps {
                        script {
                            docker.withRegistry('', REGISTRY_CREDENTIAL) {
                                dockerImageAcademic.push("${BUILD_NUMBER}")
                                dockerImageAcademic.push('latest')
                            }
                        }
                    }
                }
                stage('Push Image Discovery') {
                    steps {
                        script {
                            docker.withRegistry('', REGISTRY_CREDENTIAL) {
                                dockerImageDiscovery.push("${BUILD_NUMBER}")
                                dockerImageDiscovery.push('latest')
                            }
                        }
                    }
                }
                stage('Push Image API Gateway') {
                    steps {
                        script {
                            docker.withRegistry('', REGISTRY_CREDENTIAL) {
                                dockerImageGateway.push("${BUILD_NUMBER}")
                                dockerImageGateway.push('latest')
                            }
                        }
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            parallel {
                stage('Trivy Academic') {
                    steps {
                        sh """
                            trivy image --exit-code 0 --severity HIGH,CRITICAL \
                            --no-progress --format table \
                            --timeout 15m \
                            --scanners vuln \
                            ${DOCKER_REGISTRY}/academic-management-service:${BUILD_NUMBER}
                        """
                    }
                }
                stage('Trivy Discovery') {
                    steps {
                        sh """
                            trivy image --exit-code 0 --severity HIGH,CRITICAL \
                            --no-progress --format table \
                            --timeout 15m \
                            --scanners vuln \
                            ${DOCKER_REGISTRY}/discovery-service:${BUILD_NUMBER}
                        """
                    }
                }
                stage('Trivy API Gateway') {
                    steps {
                        sh """
                            trivy image --exit-code 0 --severity HIGH,CRITICAL \
                            --no-progress --format table \
                            --timeout 15m \
                            --scanners vuln \
                            ${DOCKER_REGISTRY}/api-gateway:${BUILD_NUMBER}
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ Build, sécurité, analyse, déploiement Nexus, Docker et Trivy réussis !'
        }
        failure {
            echo '❌ Pipeline échoué !'
        }
        always {
            junit testResults: "${BACKEND_PATH}/**/target/surefire-reports/*.xml",
                  allowEmptyResults: true

            cleanWs deleteDirs: true, patterns: [
                [pattern: '**/target/**',       type: 'INCLUDE'],
                [pattern: '**/node_modules/**', type: 'INCLUDE'],
                [pattern: '**/.m2/**',          type: 'INCLUDE'],
                [pattern: '**/build/**',        type: 'INCLUDE'],
                [pattern: '**/*.log',           type: 'INCLUDE']
            ]
        }
    }
}