pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker image version from CI')
    }

    environment {
        DOCKERHUB_REPO = "chelba/dev-unity-frontend"
        NAMESPACE      = "devunity"
        K8S_DIR        = "Front-PIDEV-4SAE7-2026-DEVUNITY/k8s"
    }

    stages {

        stage('Validate') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error("IMAGE_TAG is empty! CI did not pass version.")
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {

                    sh 'echo $PASS | docker login -u $USER --password-stdin'

                    sh 'docker pull ${DOCKERHUB_REPO}:${IMAGE_TAG}'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl apply -f ${K8S_DIR}/namespace.yaml || true
                    kubectl apply -f ${K8S_DIR}/frontend-deployment.yaml
                    kubectl apply -f ${K8S_DIR}/frontend-service.yaml
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    sleep 20
                    kubectl get pods -n ${NAMESPACE}
                    kubectl get svc -n ${NAMESPACE}
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    kubectl rollout status deployment/devunity-frontend \
                      -n ${NAMESPACE} \
                      --timeout=120s
                '''
            }
        }

        stage('Local Docker Run') {
            steps {
                sh '''
                    docker stop devunity-frontend || true
                    docker rm devunity-frontend || true

                    docker run -d \
                      --name devunity-frontend \
                      -p 4200:80 \
                      --restart unless-stopped \
                      ${DOCKERHUB_REPO}:${IMAGE_TAG}
                '''
            }
        }
    }

    post {

        success {
            mail to: 'islemraissi789@gmail.com',
                 subject: "✅ FRONTEND CD PASSED - ${env.BUILD_NUMBER}",
                 body: """
Frontend deployed successfully.

Version: ${IMAGE_TAG}

Kubernetes:
http://192.168.32.133:30080

Local:
http://192.168.32.133:4200
"""
        }

        failure {
            mail to: 'islemraissi789@gmail.com',
                 subject: "❌ FRONTEND CD FAILED - ${env.BUILD_NUMBER}",
                 body: "Check logs: ${env.BUILD_URL}"
        }
    }
}