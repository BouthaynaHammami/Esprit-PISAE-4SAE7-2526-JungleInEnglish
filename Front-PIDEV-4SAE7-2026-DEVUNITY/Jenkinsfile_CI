pipeline {
    agent any

    tools {
        nodejs 'NODE_HOME'
    }

    environment {
        FRONT_PATH   = 'Front-PIDEV-4SAE7-2026-DEVUNITY'
        SONAR_HOST   = 'http://192.168.32.133:9000'
        NEXUS_URL    = 'http://192.168.32.133:9999'
        NEXUS_REPO   = 'frontend-releases'
        DOCKER_IMAGE = 'chelba/dev-unity-frontend'

        NODE_OPTIONS = '--max-old-space-size=2048'

        // IMPORTANT
        CHROME_BIN = '/usr/bin/google-chrome'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${FRONT_PATH}") {
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir("${FRONT_PATH}") {
                    sh 'npx ng lint || true'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${FRONT_PATH}") {
                    sh '''
                        export CHROME_BIN=/usr/bin/google-chrome

                        npx ng test \
                          --watch=false \
                          --browsers=ChromeHeadless \
                          --code-coverage \
                          --no-sandbox \
                        || true
                    '''
                }
            }

            post {
                always {
                    junit testResults: "${FRONT_PATH}/coverage/**/*.xml",
                          allowEmptyResults: true
                }
            }
        }

        // BUILD BEFORE NEXUS
        stage('Build Production') {
            steps {
                dir("${FRONT_PATH}") {
                    sh 'npx ng build --configuration production'
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir("${FRONT_PATH}") {

                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {

                        sh '''
                            zip -r frontend-build-${BUILD_NUMBER}.zip dist/

                            curl -u ${NEXUS_USER}:${NEXUS_PASS} \
                              --upload-file frontend-build-${BUILD_NUMBER}.zip \
                              ${NEXUS_URL}/repository/${NEXUS_REPO}/frontend-build-${BUILD_NUMBER}.zip
                        '''
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${FRONT_PATH}") {

                    withSonarQubeEnv('SonarQube') {

                        sh '''
                            npx sonar-scanner \
                              -Dsonar.projectKey=Dev-Unity-Frontend \
                              -Dsonar.projectName="Dev Unity Frontend" \
                              -Dsonar.sources=src \
                              -Dsonar.host.url=${SONAR_HOST} \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${FRONT_PATH}") {

                    sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .'

                    sh 'docker tag ${DOCKER_IMAGE}:${BUILD_NUMBER} ${DOCKER_IMAGE}:latest'
                }
            }
        }

        stage('Push to DockerHub') {
            steps {

                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {

                    sh 'echo $PASS | docker login -u $USER --password-stdin'

                    sh 'docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}'

                    sh 'docker push ${DOCKER_IMAGE}:latest'
                }
            }
        }
    }

    post {

        success {
            mail to: 'islemraissi789@gmail.com',
                 subject: "✅ Frontend CI PASSED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Frontend build passed successfully.\nDocker image pushed.\n\n${env.BUILD_URL}"
        }

        failure {
            mail to: 'islemraissi789@gmail.com',
                 subject: "❌ Frontend CI FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Frontend build failed.\nCheck logs:\n${env.BUILD_URL}"
        }
    }
}