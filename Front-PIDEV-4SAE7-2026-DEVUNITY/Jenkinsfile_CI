pipeline {
    agent any

    tools {
        nodejs 'NODE_HOME'
    }

    environment {
        FRONT_PATH   = 'Front-PIDEV-4SAE7-2026-DEVUNITY'
        SONAR_HOST   = 'http://192.168.32.133:9000'
        NEXUS_URL    = 'http://192.168.32.133:9999'
        NEXUS_REPO   = 'frontend-releases'
        DOCKER_IMAGE = 'chelba/dev-unity-frontend'

        IMAGE_TAG = "v${BUILD_NUMBER}"

        NODE_OPTIONS = '--max-old-space-size=2048'
        CHROME_BIN   = '/usr/bin/google-chrome'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${FRONT_PATH}") {
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir("${FRONT_PATH}") {
                    sh 'npx ng lint || true'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${FRONT_PATH}") {
                    sh '''
                        export CHROME_BIN=/usr/bin/google-chrome

                        npx ng test \
                          --watch=false \
                          --browsers=ChromeHeadless \
                          --code-coverage \
                          --no-sandbox \
                        || true
                    '''
                }
            }
        }

        stage('Build Production') {
            steps {
                dir("${FRONT_PATH}") {
                    sh 'npx ng build --configuration production'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${FRONT_PATH}") {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            npx sonar-scanner \
                              -Dsonar.projectKey=Dev-Unity-Frontend \
                              -Dsonar.projectName="Dev Unity Frontend" \
                              -Dsonar.sources=src \
                              -Dsonar.host.url=${SONAR_HOST} \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${FRONT_PATH}") {
                    sh 'docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} .'
                    sh 'docker tag ${DOCKER_IMAGE}:${IMAGE_TAG} ${DOCKER_IMAGE}:latest'
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {

                    sh 'echo $PASS | docker login -u $USER --password-stdin'

                    sh 'docker push ${DOCKER_IMAGE}:${IMAGE_TAG}'
                    sh 'docker push ${DOCKER_IMAGE}:latest'
                }
            }
        }

        stage('Trigger CD') {
            steps {
                build job: 'DevUnity-Frontend-CD',
                    parameters: [
                        string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")
                    ],
                    wait: false
            }
        }
    }

    post {
        success {
            mail to: 'islemraissi789@gmail.com',
                 subject: "✅ FRONTEND CI PASSED - ${env.BUILD_NUMBER}",
                 body: "Frontend CI passed.\nImage: ${DOCKER_IMAGE}:${IMAGE_TAG}"
        }

        failure {
            mail to: 'islemraissi789@gmail.com',
                 subject: "❌ FRONTEND CI FAILED - ${env.BUILD_NUMBER}",
                 body: "Check logs: ${env.BUILD_URL}"
        }
    }
}